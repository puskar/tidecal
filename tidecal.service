[Unit]
Description=Tide Calendar service
After=network.target
StartLimitIntervalSec=0
[Service]
Type=simple
Restart=always
RestartSec=1
User=puskar
ExecStart=/home/puskar/tidecal/.venv/bin/python /home/puskar/tidecal/tidecal.py
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
